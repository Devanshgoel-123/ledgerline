# Copy to `.env` before `docker compose up`.
# Generate secrets: ./scripts/generate-docker-secrets.sh

NODE_ENV=production
LOG_LEVEL=info
# Always JSON in containers (pretty is ignored in production)
LOG_PRETTY=0

# --- Database ---
# Default: the postgres service in docker-compose.yml. If you change POSTGRES_PASSWORD,
# change it in this URL too. For hosted Postgres (Neon etc.) use
# postgresql://USER:PASSWORD@HOST/DB?sslmode=require instead.
DATABASE_URL=postgresql://ledgerline:change-me-strong-db-password@postgres:5432/ledgerline
POSTGRES_USER=ledgerline
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=ledgerline
POSTGRES_PORT=5432

# --- Published host ports (compose) ---
API_PORT=4000
WEB_PORT=3000

# --- API secrets (required; insecure defaults fail boot in production) ---
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32  (must be exactly 64 hex chars)
ENCRYPTION_KEY=

# --- URLs (browser + CORS) ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Build-time URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Safety ---
ALLOW_ANON_PARSE=0
# Proxy hops in front of the API (e.g. 1 behind nginx, Caddy or a platform load
# balancer). 0 when browsers reach the API directly, so X-Forwarded-For is ignored.
TRUST_PROXY=0

# --- Google OAuth (optional; required for Gmail pooling) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
GOOGLE_ALLOWED_EMAILS=
ADMIN_EMAILS=
GMAIL_PUBSUB_TOPIC=
# Required with GMAIL_PUBSUB_TOPIC: the push subscription must send an OIDC token
# (Pub/Sub > subscription > Enable authentication). Audience as set there, and its service account.
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=

# Telegram. With TELEGRAM_WEBHOOK_URL empty the API long-polls Telegram, in any
# NODE_ENV, so no public URL or ngrok tunnel is needed. Run one API per bot token.
# To have Telegram push instead, set TELEGRAM_WEBHOOK_URL to the API's public https
# base (e.g. https://api.example.com or an ngrok URL) and a 16+ character secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# --- Optional separate pooling worker (`docker compose --profile worker up`) ---
POOLING_WORKER_SEPARATE=0
POOLING_WORKER_HOST=worker
POOLING_WORKER_PORT=5473
POOLING_WORKER_INTERVAL_MS=21600000
# Bearer token for the worker's /status, /run and /backfill. Required when the API
# container calls it; empty allows only callers on the worker's own loopback.
POOLING_WORKER_TOKEN=

# --- Email (password reset links) ---
# Any SMTP provider, e.g. smtps://USER:PASSWORD@smtp.example.com:465
# Empty: in production, "Forgot password?" says reset by email is not set up.
SMTP_URL=
MAIL_FROM=Ledgerline <no-reply@your-domain>

# You do not need to copy this file: ./ledgerline start creates .env with
# random secrets on first run. This lists every setting it understands.

# Secrets (created for you). Keep .env: ENCRYPTION_KEY unlocks the mail app
# password stored in your database, so a backup restore needs the same value.
APP_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Ports on this computer (127.0.0.1 only). Change one if something else uses it,
# then run ./ledgerline start again.
WEB_PORT=3000
API_PORT=4000

# Optional: use a Postgres you run yourself instead of the bundled one.
# DATABASE_URL=postgres://user:password@host:5432/ledgerline

# Optional: Telegram bot (daily summaries, add expenses by chat). This is the one
# feature that sends data off your computer, to Telegram. Create a bot with
# @BotFather and paste its token. The API polls Telegram, so no public URL is needed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# LOG_LEVEL=info

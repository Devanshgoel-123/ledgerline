{
  "expo": {
    "name": "Ledgerline",
    "slug": "ledgerline",
    "version": "1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ledgerline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.ledgerline.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#102A43",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.ledgerline.mobile",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "allowBackup": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F5F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0B1219",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ledgerline uses Face ID to unlock the app when you turn on app lock."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#1D5C96",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "QuickAdd",
              "displayName": "Quick add",
              "description": "Today's spend, and add an expense in a tap.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "src/widget/QuickAddWidget.tsx"
              },
              "android": null
            }
          ]
        }
      ],
      "./plugins/withAndroidShortcuts",
      "./plugins/withBankMessageIntent"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "app.ledgerline.mobile.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.app.ledgerline.mobile"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "1e2f10e6-ea0b-444d-808c-4a3ca371d57d"
      }
    },
    "owner": "devanshgoel04s-team"
  }
}

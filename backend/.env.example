PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Pretty logs in dev: LOG_PRETTY=1

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Postgres (recommended). Use `memory` only for local/tests.
# Matches POSTGRES_PASSWORD in the root .env when you run `docker compose up -d postgres`.
DATABASE_URL=postgres://ledgerline:change-me-strong-db-password@localhost:5432/ledgerline
# DATABASE_URL=memory

# Required secrets — generate strong values for anything beyond local demos:
#   openssl rand -hex 32   → JWT_SECRET (use as string)
#   openssl rand -hex 32   → ENCRYPTION_KEY (64 hex chars)
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Invite codes are stored in the `invites` table (see migration 003_reference_data).

# Rate limiting (per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_UPLOAD_MAX=15

# Postgres pool
DB_POOL_MAX=20
DB_POOL_IDLE_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000

# Ephemeral parse without auth (dev only)
ALLOW_ANON_PARSE=0

# Google OAuth — used for sign-in (openid/email/profile) and Gmail pooling.
# Add this redirect URI in the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback
# Comma-separated allowlist. Empty = any Google account can sign in.
GOOGLE_ALLOWED_EMAILS=
# Comma-separated admin emails — can PATCH /api/admin/providers/:id logos
ADMIN_EMAILS=
GMAIL_PUBSUB_TOPIC=
# Required with GMAIL_PUBSUB_TOPIC: the push subscription must send an OIDC token
# (Pub/Sub > subscription > Enable authentication). Audience as set there, and its service account.
GMAIL_PUSH_AUDIENCE=
GMAIL_PUSH_SERVICE_ACCOUNT=

# Telegram spend prompts (optional). Leave empty until you have a bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

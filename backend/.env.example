PORT=4000
NODE_ENV=development
LOG_LEVEL=info
# Pretty logs in dev: LOG_PRETTY=1

# The web app's address. The API answers only this computer (LEDGERLINE_ALLOWED_HOSTS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Postgres (recommended). Use `memory` only for local/tests.
# Matches POSTGRES_PASSWORD in the root .env when you run `docker compose up -d postgres`.
DATABASE_URL=postgres://ledgerline:change-me-strong-db-password@localhost:5432/ledgerline
# DATABASE_URL=memory

# Required secrets — generate strong values for anything beyond local demos:
#   openssl rand -hex 32   → APP_SECRET
#   openssl rand -hex 32   → ENCRYPTION_KEY (64 hex chars; encrypts your mailbox app password)
# Older installs may still have JWT_SECRET; it is read when APP_SECRET is unset.
APP_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Rate limiting (per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_UPLOAD_MAX=15

# Postgres pool
DB_POOL_MAX=20
DB_POOL_IDLE_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000

# Bank mail is read over IMAP with an app password you enter in the app (Import).
# How often connected mailboxes are scanned; 1 turns scheduled scans off (Scan now still works).
MAIL_SCAN_INTERVAL_MS=21600000
DISABLE_MAIL_JOBS=0

# Telegram spend prompts (optional). Leave empty until you have a bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

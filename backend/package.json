{
  "name": "upi-expense-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "POOLING_WORKER_PORT=5473 LOG_LEVEL=debug tsx watch src/worker/poolingServer.ts",
    "worker": "POOLING_WORKER_PORT=5473 tsx src/worker/poolingServer.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && npm run copy:assets",
    "copy:assets": "mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test tsx --test tests/unit/*.test.ts && NODE_ENV=test tsx tests/integration/smoke-test.ts && NODE_ENV=test tsx tests/integration/product-test.ts",
    "test:db": "NODE_ENV=test tsx --test --test-concurrency=1 tests/unit/sharedProviders.test.ts tests/unit/*.db.test.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:down": "tsx src/db/migrate-cli.ts --down",
    "seed": "tsx src/db/seeds/demo.ts",
    "allow-email": "tsx src/scripts/approveEmail.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "googleapis": "^185.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^10.1.7",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
